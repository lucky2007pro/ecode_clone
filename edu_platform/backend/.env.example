# =================================================================
# EXODE PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# =================================================================

# 1. DATABASE & REDIS CONFIGURATION
DATABASE_URL=postgresql+asyncpg://postgres:<password>@localhost:5432/exode_db
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://localhost:6379/0
# SQL querilarni log qilish (faqat debug uchun)
DB_ECHO=false

# 2. JWT AUTHENTICATION
# Yangi secret yaratish: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=super-secret-jwt-key-replace-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_DAYS=7

# 3. CORS — vergul bilan ajratilgan ruxsat berilgan originlar
ALLOWED_ORIGINS=http://localhost:5173

# 4. KINESCOPE VIDEO INTEGRATION (https://kinescope.io)
# Dashboard -> Settings -> API Keys bo'limidan olinadi
KINESCOPE_API_KEY=your_kinescope_bearer_api_key_here
KINESCOPE_PROJECT_ID=your_kinescope_project_id
KINESCOPE_WEBHOOK_SECRET=your_kinescope_webhook_secret

# 5. KOMMO CRM v4 INTEGRATION (https://kommo.com)
# Settings -> Integrations -> Create Integration bo'limidan olinadi
KOMMO_SUBDOMAIN=your_kommo_subdomain_here
KOMMO_CLIENT_ID=your_kommo_integration_client_id
KOMMO_CLIENT_SECRET=your_kommo_secret_key
KOMMO_ACCESS_TOKEN=your_kommo_long_lived_access_token
KOMMO_AUTHORIZATION_CODE=your_kommo_oauth_authorization_code
KOMMO_REDIRECT_URI=https://api.exode.biz/api/v1/crm/oauth/callback

# 6. TELEGRAM BOT API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CLOSED_CHANNEL_ID=-100123456789

# 7. SMTP TRANSACTIONAL EMAIL
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@exode.biz
SMTP_PASS=your_smtp_password

# 8. TO'LOV TIZIMLARI (hozircha kodda ulanmagan — kelajakda ishlatiladi)
# Click (https://click.uz)
CLICK_SERVICE_ID=your_click_service_id
CLICK_MERCHANT_ID=your_click_merchant_id
CLICK_SECRET_KEY=your_click_secret_key
# Payme (https://payme.uz)
PAYME_MERCHANT_ID=your_payme_merchant_id
PAYME_SECRET_KEY=your_payme_secret_key
# Uzum Bank
UZUM_BANK_MERCHANT_ID=your_uzum_merchant_id
UZUM_BANK_SECRET_KEY=your_uzum_secret_key
