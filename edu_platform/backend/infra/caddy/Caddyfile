# Exode.biz Dynamic SSL & Custom Domain Caddyfile

{
    # Let's Encrypt Email
    email admin@exode.biz
    # On-Demand TLS: Har bir yangi custom domen ulaganda avtomatik SSL oladi
    on_demand_tls {
        ask http://gateway:8000/api/v1/schools/check-domain
    }
}

# Asosiy Exode domenlari
exode.biz, *.exode.biz {
    reverse_proxy gateway:8000
}

# Har qanday biriktirilgan Shaxsiy Domen (Custom Domain)
:443 {
    tls {
        on_demand
    }
    reverse_proxy gateway:8000
}
